{
  "name": "writer-webapp",
  "private": true,
  "description": "Writer's React editing workspace, calling the service through a generated API client",
  "type": "module",
  "engines": {
    "node": "26.13.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "budget": "node scripts/bundle-budget.js",
    "api:generate": "openapi-typescript ../service/openapi.json --output src/api/generated/schema.d.ts",
    "api:check": "node scripts/api-check.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --type-aware --deny-warnings",
    "typecheck": "vite-css-modules --silent && tsc",
    "test": "vitest run",
    "e2e:browsers": "node scripts/e2e-browsers.js",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-bold": "3.34.0",
    "@tiptap/extension-code": "3.34.0",
    "@tiptap/extension-heading": "3.34.0",
    "@tiptap/extension-italic": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "idb": "8.0.4",
    "lucide-react": "1.72.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm-footnote": "2.1.0",
    "mdast-util-gfm-strikethrough": "2.0.1",
    "mdast-util-gfm-table": "2.0.1",
    "mdast-util-gfm-task-list-item": "2.0.1",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm-footnote": "2.1.0",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "micromark-extension-gfm-table": "2.1.2",
    "micromark-extension-gfm-task-list-item": "2.1.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/mdast": "4.0.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.0",
    "openapi-typescript": "7.13.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-css-modules": "1.16.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
