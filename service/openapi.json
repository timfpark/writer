          },
          "404": {
            "description": "No folder has the identifier.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "The request body exceeds the size limit.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "The request body is not sent as application/json.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The request body breaks the schema or a workspace rule; `errors` names each field.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "The service failed unexpectedly.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Report that the service can serve requests.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "The service can serve requests.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "description": "The service failed unexpectedly.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspace": {
      "get": {
        "tags": [
          "workspace"
        ],
        "summary": "Read the whole workspace tree.",
        "operationId": "getWorkspace",
        "responses": {
          "200": {
            "description": "Every folder and document, in pre-order.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "500": {
            "description": "The service failed unexpectedly.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateDocumentRequest": {
        "type": "object",
        "description": "A document to create with a client-generated identifier.",
        "required": [
          "documentId",
          "parentId",
          "beforeId",
          "title"
        ],
        "properties": {
          "beforeId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The sibling to create it before, or `null` for the end."
          },
          "documentId": {
            "type": "string",
            "description": "A new lowercase hyphenated UUID, generated by the client."
          },
          "language": {
            "type": "string",
            "description": "The document's BCP 47 language tag (`en` or `es`); `en` when omitted."
          },
          "markdown": {
            "type": "string",
            "description": "The initial content, at most 1 MiB of UTF-8 without U+0000; empty\nwhen omitted."
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The folder to create it in, or `null` for the top level."
          },
          "title": {
            "type": "string",
            "description": "1 to 200 characters with no surrounding whitespace or control\ncharacters."
          }
        },
        "additionalProperties": false
      },
      "CreateFolderRequest": {
        "type": "object",
        "description": "A folder to create with a client-generated identifier.",
        "required": [
          "folderId",
          "parentId",
          "beforeId",
          "title"
        ],
        "properties": {
          "beforeId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The sibling to create it before, or `null` for the end."
          },
          "folderId": {
            "type": "string",
            "description": "A new lowercase hyphenated UUID, generated by the client."
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The folder to create it in, or `null` for the top level."
          },
          "title": {
            "type": "string",
            "description": "1 to 200 characters with no surrounding whitespace or control\ncharacters."
          }
        },
        "additionalProperties": false
      },
      "Document": {
        "type": "object",
        "description": "A document's metadata and the revision of its content.",
        "required": [
          "id",
          "parentId",
          "title",
          "language",
          "revision"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "language": {
            "type": "string",
            "description": "The document's BCP 47 language tag (`en` or `es`)."
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The containing folder, or `null` at the top level."
          },
          "revision": {
            "type": "string",
            "description": "An opaque token that changes whenever the content changes; compare\nit only for equality."
          },
          "title": {
            "type": "string"
          }
        }
      },
      "DocumentContent": {
        "type": "object",
        "description": "A document's content and its revision.",
        "required": [
          "markdown",
          "revision"
        ],
        "properties": {
          "markdown": {
            "type": "string",
            "description": "The document's Markdown, exactly as stored."
          },
          "revision": {
            "type": "string"
          }
        }
      },
      "Folder": {
        "type": "object",
        "description": "A folder, which holds folders and documents.",
        "required": [
          "id",
          "parentId",
          "title"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The containing folder, or `null` at the top level."
          },
          "title": {
            "type": "string"
          }
        }
      },
      "Health": {
        "type": "object",
        "description": "Whether the service can serve requests.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        }
      },
      "HealthStatus": {
        "type": "string",
        "enum": [
          "ok"
        ]
      },
      "ItemKind": {
        "type": "string",
        "enum": [
          "folder",
          "document"
        ]
      },
      "Problem": {
        "type": "object",
        "description": "An RFC 9457 problem details object describing why a request failed.",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "errors"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ProblemCode"
          },
          "detail": {
            "type": "string",
            "description": "A short explanation of this occurrence, written by the service."
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProblemFieldError"
            },
            "description": "One entry per invalid request body field; otherwise empty."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "The HTTP status code, repeated from the response.",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "The standard reason phrase for `status`."
          },
          "type": {
            "type": "string",
            "description": "Always `about:blank`; branch on `code` instead."
          }
        }
      },
      "ProblemCode": {
        "type": "string",
        "description": "The kind of error; treat an unrecognized code according to the status.",
        "enum": [
          "malformedRequest",
          "notFound",
          "methodNotAllowed",
          "conflict",
          "payloadTooLarge",
          "unsupportedMediaType",
          "validationFailed",
          "internalError",
          "upstreamFailed",
          "unavailable",
          "upstreamTimeout"
        ]
      },
      "ProblemFieldError": {
        "type": "object",
        "description": "One invalid field in a request body.",
        "required": [
          "pointer",
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string"
          },
          "pointer": {
            "type": "string",
            "description": "A JSON Pointer to the field, or `\"\"` for the whole body."
          }
        }
      },
      "ReplaceContentRequest": {
        "type": "object",
        "description": "A whole new content for a document, checked against the revision the\nclient's edits started from.",
        "required": [
          "markdown",
          "baseRevision"
        ],
        "properties": {
          "baseRevision": {
            "type": "string",
            "description": "The revision of the content the edits started from."
          },
          "markdown": {
            "type": "string",
            "description": "At most 1 MiB of UTF-8 without U+0000."
          }
        },
        "additionalProperties": false
      },
      "ReplaceLanguageRequest": {
        "type": "object",
        "description": "A new language for a document.",
        "required": [
          "language"
        ],
        "properties": {
          "language": {
            "type": "string",
            "description": "A supported BCP 47 language tag (`en` or `es`)."
          }
        },
        "additionalProperties": false
      },
      "ReplacePositionRequest": {
        "type": "object",
        "description": "Where to move a folder or document with its subtree.",
        "required": [
          "parentId",
          "beforeId"
        ],
        "properties": {
          "beforeId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The sibling to place the item before, or `null` for the end."
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The folder to place the item in, or `null` for the top level."
          }
        },
        "additionalProperties": false
      },
      "ReplaceTitleRequest": {
        "type": "object",
        "description": "A new title for a folder or document.",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "1 to 200 characters with no surrounding whitespace or control\ncharacters."
          }
        },
        "additionalProperties": false
      },
      "Workspace": {
        "type": "object",
        "description": "The whole workspace tree.",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkspaceItem"
            },
            "description": "Every item in pre-order: each folder is followed by its subtree before\nits next sibling, and siblings appear in their order."
          }
        }
      },
      "WorkspaceItem": {
        "type": "object",
        "description": "One folder or document in the tree, without content.",
        "required": [
          "id",
          "kind",
          "parentId",
          "title",
          "language"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ItemKind"
          },
          "language": {
            "type": [
              "string",
              "null"
            ],
            "description": "The document's BCP 47 language tag (`en` or `es`), or `null` for a\nfolder."
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ],
            "description": "The containing folder, or `null` at the top level."
          },
          "title": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Whether the service can serve requests"
    },
    {
      "name": "workspace",
      "description": "The whole tree of folders and documents"
    },
    {
      "name": "folders",
      "description": "Folders, which hold folders and documents"
    },
    {
      "name": "documents",
      "description": "Documents and their Markdown content"
    }
  ]
}
