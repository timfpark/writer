# Settings the development server reads from its environment or from a
# webapp/.env file, which Git ignores. None reaches the browser bundle.
# Never put a real credential in this file or any committed copy of it.

# Loopback port of the service that /api/ requests are proxied to, from 1 to
# 65535. Set it when the service runs with WRITER_PORT. Default: 8888.
WRITER_SERVICE_PORT=8888
