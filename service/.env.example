# Settings that writer-server reads from its process environment. It does not
# load this file; export a variable or prefix the command with it instead.
# Never put a real credential in this file or any committed copy of it.

# Loopback port for the HTTP API, from 1 to 65535. The address is always
# 127.0.0.1. Default: 8888.
WRITER_PORT=8888

# Folder holding Writer's data; the workspace lives in workspace/ inside it,
# created on first use. A relative path resolves against the working
# directory, and an empty value is invalid. Default: .local/data/ at the
# repository root for debug builds (cargo run), and the per-user data folder
# (~/Library/Application Support/Writer on macOS, $XDG_DATA_HOME/writer or
# ~/.local/share/writer on Linux) for release builds.
# WRITER_DATA_DIR=/path/to/writer-data

# Pair-writer provider: ollama (default), scripted (deterministic replies for
# tests and demonstrations), or none (starts without a pair writer, reporting
# notConfigured and answering turns with 503 unavailable).
# WRITER_PAIR_WRITER=ollama

# Local Ollama server address when WRITER_PAIR_WRITER=ollama (the default).
# Defaults to http://127.0.0.1:11434 on the host. Inside the development
# container, set http://host.docker.internal:11434 to reach Ollama on the host.
# OLLAMA_HOST=http://127.0.0.1:11434

# Conversation model served by Ollama when WRITER_PAIR_WRITER=ollama.
# Defaults to gemma4:31b-mlx (ADR 0010).
# WRITER_CONVERSATION_MODEL=gemma4:31b-mlx

# Behavior of the scripted pair writer when WRITER_PAIR_WRITER=scripted:
# ready (default), missing-model (reports modelMissing and returns 503), or
# fail-mid-stream (streams a few tokens then emits an SSE error event).
# WRITER_SCRIPTED_MODE=ready

# Pacing overrides for the scripted pair writer, in milliseconds and tokens per
# second. Defaults mirror ADR 0010's local model timings.
# WRITER_SCRIPTED_FIRST_TOKEN_MS=2000
# WRITER_SCRIPTED_MS_PER_1000_WORDS=3000
# WRITER_SCRIPTED_FOLLOWUP_FIRST_TOKEN_MS=450
# WRITER_SCRIPTED_TOKENS_PER_SEC=30
# WRITER_SCRIPTED_REVIEW_MS=1200
