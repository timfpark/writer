// Shared development container for every toolchain that tools/check needs.
// Setup steps live in the root README.md. When a toolchain, dependency, or
// environment requirement changes, update the pins in this folder and the
// setup documentation in the same change, as the root AGENTS.md requires.
{
  "name": "Writer",
  // Pins the base image by digest and configures the registry proxies.
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:2.1.2": {
      // The single record of the container's Node.js version. npm is the
      // release bundled with this Node.js version.
      "version": "26.13.1",
      "nvmVersion": "0.41.0",
      "pnpmVersion": "none",
      "nodeGypDependencies": false
    },
    "ghcr.io/devcontainers/features/rust:1.6.1": {
      // Installs rustup with this default toolchain. A subsystem's
      // rust-toolchain.toml takes precedence inside its folder.
      "version": "1.100.0",
      "profile": "minimal"
    },
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {
      // Installs gh from GitHub's GPG-signed apt repository rather than an
      // unverified release download. GitHub's apt index retains only the
      // current release, so pinning an exact version breaks builds on every
      // gh release.
      "version": "latest",
      "installDirectlyFromGitHubRelease": false
    },
    // A local feature, after node: installs the headless Chromium and WebKit
    // builds of this Playwright release, with their system
    // libraries, into /ms-playwright. Keep it equal to @playwright/test in
    // webapp/package.json; tools/check exits 2 when the browsers do not
    // match.
    "./playwright": {
      "version": "1.65.1"
    }
  },
  "containerUser": "vscode",
  "remoteUser": "vscode",
  // The service listens on loopback port 8888 (service/README.md) and the
  // webapp's development server on loopback port 5180 (webapp/README.md).
  // Supply any credential at run time, never through this folder, the image,
  // or build arguments.
  "forwardPorts": [8888, 5180],
  // gh reads a fine-grained token, scoped to this repository, from the host
  // environment that starts the container; README.md says how to create it.
  // When it is unset, gh is unauthenticated.
  "remoteEnv": {
    "GH_TOKEN": "${localEnv:GH_TOKEN}"
  },
  "portsAttributes": {
    "8888": {
      "label": "service"
    },
    "5180": {
      "label": "webapp"
    }
  }
}
