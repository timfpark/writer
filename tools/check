#!/usr/bin/env bash
# Repository validation gate: runs every phase, reports each result, and exits
# 0 only when all phases pass. Exit 1 means a check failed; exit 2 means a
# usage error or a missing prerequisite.
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: tools/check

Runs every validation phase from the repository root:
  tools    unit tests for the repository tooling (Python 3.9+)
  docs     Markdown frontmatter, relative links, index coverage, and style lint
  service  formatting, lint, build, and tests of every service/ workspace member,
           including the service/openapi.json freshness test (cargo via rustup)
  webapp   install, generated client freshness, formatting, lint, types, tests,
           build, and bundle budget of webapp/
  browser  Playwright browser and accessibility tests of webapp/e2e/, driving
           the development server against a real service

Node.js must be exactly the version webapp/package.json pins in engines.node.
The browser phase needs the Playwright browsers that webapp/package.json pins;
the development container carries them.

Exit codes: 0 all phases passed, 1 a phase failed, 2 usage or prerequisite error.
USAGE
}

case "${1:-}" in
  -h | --help) usage; exit 0 ;;
  "") ;;
  *) usage >&2; exit 2 ;;
esac

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"

if ! command -v python3 >/dev/null 2>&1 ||
  ! python3 -c 'import sys; sys.exit(sys.version_info < (3, 9))'; then
  echo "check: prerequisite missing: python3 3.9 or newer must be on PATH" >&2
  exit 2
fi

if ! node_pin="$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1], encoding="utf-8"))["engines"]["node"])' webapp/package.json 2>/dev/null)"; then
  echo "check: prerequisite missing: webapp/package.json must pin the Node.js version in engines.node" >&2
  exit 2
fi

node_found=""
if command -v node >/dev/null 2>&1; then
  node_found="$(node -p 'process.versions.node' 2>/dev/null)" || node_found=""
fi
if [[ "$node_found" != "$node_pin" ]]; then
  echo "check: prerequisite missing: Node.js $node_pin (node), the version webapp/package.json engines.node pins, must be on PATH; found ${node_found:-none}" >&2
  exit 2
fi

if ! command -v npm >/dev/null 2>&1; then
  echo "check: prerequisite missing: npm must be on PATH" >&2
  exit 2
fi

if ! command -v cargo >/dev/null 2>&1; then
  echo "check: prerequisite missing: cargo (installed with rustup) must be on PATH" >&2
  exit 2
fi

tools_lock_stamp() {
  python3 - tools/.npmrc tools/package.json tools/package-lock.json <<'PY'
import hashlib, pathlib, sys
digest = hashlib.sha256()
for arg in sys.argv[1:]:
    digest.update(arg.encode("utf-8") + b"\0")
    digest.update(pathlib.Path(arg).read_bytes() + b"\0")
print(digest.hexdigest())
PY
}

ensure_tools_npm() {
  local bin="$root/tools/node_modules/.bin/markdownlint-cli2"
  local stamp_file="$root/tools/node_modules/.lock-stamp"
  local expected
  expected="$(tools_lock_stamp)" || return 1
  if [[ -x "$bin" && -f "$stamp_file" && "$(<"$stamp_file")" == "$expected" ]]; then
    return 0
  fi
  (cd "$root/tools" && npm ci --include=dev --no-audit --no-fund) || return 1
  printf '%s\n' "$expected" >"$stamp_file" || return 1
}

run_docs_phase() {
  ensure_tools_npm || return 1
  local rc=0
  python3 tools/check_docs.py || rc=1
  "$root/tools/node_modules/.bin/markdownlint-cli2" || rc=1
  return "$rc"
}

# Runs every step so one report lists all failures. UPDATE_OPENAPI is removed
# so the contract test always compares service/openapi.json, never rewrites it.
run_service_phase() {
  (
    cd "$root/service" || exit 1
    unset UPDATE_OPENAPI
    rc=0
    cargo fmt --all --check || rc=1
    cargo clippy --workspace --all-targets --locked -- -D warnings || rc=1
    cargo build --workspace --all-targets --locked || rc=1
    cargo test --workspace --locked || rc=1
    exit "$rc"
  )
}

# Every step after the install needs node_modules, so a failed install stops
# the phase; otherwise every step runs so one report lists all failures.
run_webapp_phase() {
  (
    cd "$root/webapp" || exit 1
    npm ci --include=dev --no-audit --no-fund || exit 1
    rc=0
    for script in api:check format:check lint typecheck test build budget; do
      npm run "$script" || rc=1
    done
    exit "$rc"
  )
}

# Uses the webapp phase's install. The browsers step exits 2 when a browser
# cannot launch, which the gate reports as a missing prerequisite, and the
# tests do not run.
run_browser_phase() {
  (
    cd "$root/webapp" || exit 1
    npm run e2e:browsers || exit
    npm run e2e
  )
}

# A phase exiting 2 lacks a prerequisite; any other nonzero status failed.
failed=()
missing=()
run_phase() {
  local name="$1"
  shift
  echo "==> $name"
  local status=0
  "$@" || status=$?
  if ((status == 0)); then
    echo "<== $name: passed"
  elif ((status == 2)); then
    echo "<== $name: PREREQUISITE MISSING" >&2
    missing+=("$name")
  else
    echo "<== $name: FAILED" >&2
    failed+=("$name")
  fi
}

run_phase tools env PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover --start-directory tools/tests --quiet
run_phase docs run_docs_phase
run_phase service run_service_phase
run_phase webapp run_webapp_phase
run_phase browser run_browser_phase

if ((${#missing[@]})); then
  echo "check: prerequisite missing in phases: ${missing[*]}" >&2
fi
if ((${#failed[@]})); then
  echo "check: FAILED phases: ${failed[*]}" >&2
  exit 1
fi
if ((${#missing[@]})); then
  exit 2
fi
echo "check: all phases passed"
