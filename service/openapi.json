{
  "openapi": "3.1.0",
  "info": {
    "title": "Writer API",
    "description": "HTTP API of the Writer service, the contract of record for its clients.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Report that the service can serve requests.",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "The service can serve requests.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "500": {
            "description": "The service failed unexpectedly.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "description": "Whether the service can serve requests.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        }
      },
      "HealthStatus": {
        "type": "string",
        "enum": [
          "ok"
        ]
      },
      "Problem": {
        "type": "object",
        "description": "An RFC 9457 problem details object describing why a request failed.",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "code",
          "errors"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ProblemCode"
          },
          "detail": {
            "type": "string",
            "description": "A short explanation of this occurrence, written by the service."
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProblemFieldError"
            },
            "description": "One entry per invalid request body field; otherwise empty."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "The HTTP status code, repeated from the response.",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "The standard reason phrase for `status`."
          },
          "type": {
            "type": "string",
            "description": "Always `about:blank`; branch on `code` instead."
          }
        }
      },
      "ProblemCode": {
        "type": "string",
        "description": "The kind of error; treat an unrecognized code according to the status.",
        "enum": [
          "malformedRequest",
          "notFound",
          "methodNotAllowed",
          "conflict",
          "payloadTooLarge",
          "unsupportedMediaType",
          "validationFailed",
          "internalError",
          "upstreamFailed",
          "unavailable",
          "upstreamTimeout"
        ]
      },
      "ProblemFieldError": {
        "type": "object",
        "description": "One invalid field in a request body.",
        "required": [
          "pointer",
          "detail"
        ],
        "properties": {
          "detail": {
            "type": "string"
          },
          "pointer": {
            "type": "string",
            "description": "A JSON Pointer to the field, or `\"\"` for the whole body."
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Whether the service can serve requests"
    }
  ]
}
